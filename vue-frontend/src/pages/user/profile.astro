---
import Layout from '../../layouts/Layout.astro';
import MitraSidebar from '../../components/mitra/sidebar/MitraSidebar.astro';
import MitraNavbar from '../../components/mitra/navbar/MitraNavbar.astro';
// User Profile Edit
---

<Layout title="Edit Profile - Sagawa Mitra">

<!-- Modern Profile Edit Styles -->
<style>
  /* CSS Custom Properties for performance */
  :root {
    --primary-gradient: linear-gradient(135deg, rgb(245 158 11), rgb(249 115 22));
    --primary-hover: linear-gradient(135deg, rgb(217 119 6), rgb(234 88 12));
    --card-gradient: linear-gradient(135deg, rgba(255, 255, 255, 0.98) 0%, rgba(251, 191, 36, 0.02) 100%);
    --shadow-primary: 0 20px 25px -5px rgba(251, 191, 36, 0.1), 0 10px 10px -5px rgba(251, 191, 36, 0.04);
  }
  
  /* Global fixes for scroll stability */
  * {
    transform: translateZ(0);
    will-change: auto;
  }
  
  *,
  *::before,
  *::after {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    -webkit-perspective: 1000px;
    perspective: 1000px;
  }
  
  body, html {
    overflow-x: hidden;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  
  /* Ensure logout button is always clickable */
  #logout-btn {
    pointer-events: auto !important;
    cursor: pointer !important;
  }
  
  #logout-btn:disabled {
    pointer-events: auto !important;
    cursor: pointer !important;
    opacity: 1 !important;
  }
  
  .modern-card:hover {
    box-shadow: 0 20px 25px -5px rgba(251, 191, 36, 0.1), 0 10px 10px -5px rgba(251, 191, 36, 0.04);
    border-color: rgba(251, 191, 36, 0.2);
  }

  /* Form input styling */
  .form-input:focus {
    box-shadow: 0 0 0 3px rgba(245, 158, 11, 0.1);
    border-color: rgb(245 158 11);
    transform: scale(1.01);
  }

  /* Button hover effects */
  .btn-primary {
    background: linear-gradient(135deg, rgb(245 158 11), rgb(249 115 22));
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .btn-primary:hover {
    background: linear-gradient(135deg, rgb(217 119 6), rgb(234 88 12));
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -3px rgba(245, 158, 11, 0.3);
  }
  
  /* Status badge styling */
  .status-badge {
    background: linear-gradient(135deg, rgb(245 158 11), rgb(251 191 36));
    animation: pulse 2s infinite;
  }
  
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.8; }
  }

  /* Background pattern - consistent with dashboard */
  .dashboard-bg {
    background: linear-gradient(-45deg, #fef7ed, #fff7ed, #fef3c7, #fefce8);
    background-size: 400% 400%;
    animation: gradientShift 15s ease infinite;
    min-height: 100vh;
  }
  
  @keyframes gradientShift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }

  /* Modern card styling - consistent with other pages */
  .modern-card {
    background: var(--card-gradient);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(251, 191, 36, 0.1);
    transform: translate3d(0, 0, 0);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    position: relative;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* Mobile responsive improvements */
  @media (max-width: 640px) {
    .dashboard-bg {
      padding: 0.5rem !important;
    }
    .dashboard-bg > div {
      padding: 1rem !important;
      margin-top: 4rem !important;
    }
    .modern-card {
      margin: 0.5rem 0;
      border-radius: 1rem;
    }
    .modern-card .p-8 {
      padding: 1.5rem !important;
    }
    .grid {
      gap: 1rem !important;
    }
  }
  
  @media (max-width: 480px) {
    .dashboard-bg {
      padding: 0.25rem !important;
    }
    .dashboard-bg > div {
      padding: 0.75rem !important;
    }
    .modern-card .p-8 {
      padding: 1rem !important;
    }
    .text-2xl {
      font-size: 1.25rem !important;
    }
    .text-3xl {
      font-size: 1.5rem !important;
    }
  }

  /* ========== SKELETON LOADING STYLES ========== */
  .skeleton {
    background: linear-gradient(
      90deg,
      rgba(251, 191, 36, 0.08) 0%,
      rgba(251, 191, 36, 0.15) 50%,
      rgba(251, 191, 36, 0.08) 100%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s ease-in-out infinite;
    border-radius: 0.5rem;
  }

  @keyframes shimmer {
    0% {
      background-position: -200% 0;
    }
    100% {
      background-position: 200% 0;
    }
  }

  .skeleton-avatar {
    width: 80px;
    height: 80px;
    border-radius: 50%;
  }

  .skeleton-text {
    height: 1rem;
    border-radius: 0.25rem;
  }

  .skeleton-text-lg {
    height: 1.5rem;
    border-radius: 0.375rem;
  }

  .skeleton-title {
    height: 2rem;
    border-radius: 0.5rem;
  }

  .skeleton-input {
    height: 3rem;
    border-radius: 0.75rem;
  }

  .skeleton-textarea {
    height: 6rem;
    border-radius: 0.75rem;
  }

  .skeleton-badge {
    height: 2.5rem;
    width: 160px;
    border-radius: 9999px;
  }

  .skeleton-button {
    height: 3rem;
    border-radius: 0.75rem;
  }

  /* ========== FADE-IN ANIMATIONS ========== */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .fade-in-up {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }

  .fade-in-scale {
    animation: fadeInScale 0.5s ease-out forwards;
    opacity: 0;
  }

  /* Stagger delays for smooth sequential animations */
  .stagger-1 { animation-delay: 0.05s; }
  .stagger-2 { animation-delay: 0.1s; }
  .stagger-3 { animation-delay: 0.15s; }
  .stagger-4 { animation-delay: 0.2s; }
  .stagger-5 { animation-delay: 0.25s; }
  .stagger-6 { animation-delay: 0.3s; }

  /* ========== ENHANCED FORM INPUTS ========== */
  .form-input-enhanced {
    position: relative;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    border: 2px solid rgba(251, 191, 36, 0.2);
  }

  .form-input-enhanced:focus {
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(251, 146, 60, 0.2),
                0 0 0 3px rgba(245, 158, 11, 0.1);
    border-color: rgb(249, 115, 22);
  }

  .form-input-enhanced:hover:not(:focus) {
    border-color: rgba(251, 191, 36, 0.4);
  }

  /* Label animation */
  .form-label {
    transition: all 0.2s ease;
  }

  .form-input-enhanced:focus + .form-label {
    color: rgb(249, 115, 22);
  }

  /* ========== PROFILE HEADER ENHANCEMENTS ========== */
  .profile-avatar-wrapper {
    position: relative;
    transition: all 0.3s ease;
  }

  .profile-avatar-wrapper:hover {
    transform: scale(1.05);
  }

  .profile-avatar {
    background: linear-gradient(135deg, rgb(249 115 22), rgb(245 158 11));
    box-shadow: 0 8px 20px rgba(249, 115, 22, 0.3);
    transition: all 0.3s ease;
  }

  /* ========== INFO SECTION CARDS ========== */
  .info-card {
    background: rgba(255, 255, 255, 0.6);
    border: 1px solid rgba(251, 191, 36, 0.15);
    transition: all 0.3s ease;
    backdrop-filter: blur(8px);
  }

  .info-card:hover {
    background: rgba(255, 255, 255, 0.8);
    border-color: rgba(251, 191, 36, 0.3);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(251, 146, 60, 0.15);
  }

  /* ========== SECTION DIVIDER ========== */
  .section-divider {
    height: 2px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(251, 191, 36, 0.3) 50%,
      transparent
    );
  }

  /* Mobile skeleton adjustments */
  @media (max-width: 640px) {
    .skeleton-avatar {
      width: 64px;
      height: 64px;
    }
    
    .skeleton-badge {
      width: 140px;
      height: 2rem;
    }
  }
</style>

<MitraNavbar />
<MitraSidebar currentPage="profile" />

<div class="dashboard-bg min-h-screen p-2 sm:p-4 transition-all duration-300" style="transform: translate3d(0, 0, 0); -webkit-backface-visibility: hidden; backface-visibility: hidden;">
   <div class="p-2 sm:p-6 mt-16" style="transform: translate3d(0, 0, 0); -webkit-backface-visibility: hidden; backface-visibility: hidden;">
