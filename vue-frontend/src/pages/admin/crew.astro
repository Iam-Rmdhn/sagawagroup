<script>
  // API URL configuration
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

  // Check authentication on page load
  function checkAuth() {
    const token = localStorage.getItem('adminToken');
    if (!token) {
      window.location.href = '/login';
      return false;
    }
    return true;
  }

  // Store for crew data
  let crewData: Array<any> = [];

  // Render crew table
  function renderCrewTable(crewList: any[]) {
    const tbody = document.getElementById('crewTableBody')!;
    const searchTerm = (document.getElementById('searchInput') as HTMLInputElement)?.value.toLowerCase() || '';
    const statusFilter = (document.getElementById('statusFilter') as HTMLSelectElement)?.value || 'all';

    // Filter data
    const filteredData = crewList.filter(crew => {
      const matchesSearch = crew.nama.toLowerCase().includes(searchTerm) ||
                           crew.email.toLowerCase().includes(searchTerm) ||
                           crew.divisi.toLowerCase().includes(searchTerm);
      const matchesStatus = statusFilter === 'all' || crew.status === statusFilter;
      return matchesSearch && matchesStatus;
    });

    if (filteredData.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="7" class="text-center py-12 bg-gray-50">
            <div class="flex flex-col items-center justify-center space-y-4">
              <svg class="w-16 h-16 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
              </svg>
              <div>
                <p class="text-lg font-semibold text-gray-600">Tidak ada data yang sesuai</p>
                <p class="text-sm text-gray-500 mt-1">Coba ubah filter pencarian atau tambah crew baru</p>
              </div>
            </div>
          </td>
        </tr>
      `;
      return;
    }

      tbody.innerHTML = filteredData.map(crew => `
      <tr class="hover:bg-orange-50/50 transition-colors">
        <td class="px-6 py-4">
          <div class="font-medium text-gray-900">${crew.nama}</div>
        </td>
        <td class="px-6 py-4 text-gray-700">${crew.email}</td>
        <td class="px-6 py-4 text-gray-700">${crew.nomorHP || '-'}</td>
        <td class="px-6 py-4">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
            ${crew.divisi || '-'}
          </span>
        </td>
        <td class="px-6 py-4">
          ${crew.kemitraan ? `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 border border-purple-200">${crew.kemitraan}</span>` : '<span class="text-gray-400">-</span>'}
        </td>
        <td class="px-6 py-4">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${
            crew.status === 'active' 
              ? 'bg-green-100 text-green-800 border-2 border-green-300' 
              : 'bg-gray-100 text-gray-800 border-2 border-gray-300'
          }">
            ${crew.status === 'active' ? '✓ Aktif' : '✗ Non-Aktif'}
          </span>
        </td>
        <td class="px-6 py-4">
          <div class="flex items-center justify-center gap-2">
            <button onclick="editCrew('${crew._id}')" class="inline-flex items-center px-3 py-1.5 bg-blue-500 hover:bg-blue-600 text-white rounded-lg text-sm font-medium transition-colors shadow-sm hover:shadow-md" title="Edit Crew">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
              </svg>
            </button>
            <button onclick="toggleCrewStatus('${crew._id}')" class="inline-flex items-center px-3 py-1.5 ${
              crew.status === 'active' 
                ? 'bg-gray-500 hover:bg-gray-600' 
                : 'bg-green-500 hover:bg-green-600'
            } text-white rounded-lg text-sm font-medium transition-colors shadow-sm hover:shadow-md" title="${crew.status === 'active' ? 'Non-Aktifkan' : 'Aktifkan'}">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                ${crew.status === 'active' 
                  ? '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"></path>'
                  : '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>'
                }
              </svg>
            </button>
            <button onclick="deleteCrew('${crew._id}')" class="inline-flex items-center px-3 py-1.5 bg-red-500 hover:bg-red-600 text-white rounded-lg text-sm font-medium transition-colors shadow-sm hover:shadow-md" title="Hapus Crew">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            </button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  // Update stats
  function updateStats(crewList: any[]) {
    const total = crewList.length;
    const active = crewList.filter(c => c.status === 'active').length;
    const inactive = total - active;

    document.getElementById('totalCrew')!.textContent = total.toString();
    document.getElementById('activeCrew')!.textContent = active.toString();
    document.getElementById('inactiveCrew')!.textContent = inactive.toString();
  }

  // Hide skeleton and show actual content
  function hideSkeletonAndShowContent() {
    const skeletonHeader = document.getElementById('skeleton-header');
    const actualHeader = document.getElementById('actual-header');
    const skeletonStats = document.getElementById('skeleton-stats');
    const actualStats = document.getElementById('actual-stats');
    
    if (skeletonHeader) skeletonHeader.style.display = 'none';
    if (actualHeader) actualHeader.classList.remove('content-hidden');
    if (skeletonStats) skeletonStats.style.display = 'none';
    if (actualStats) actualStats.classList.remove('content-hidden');
  }

  // Load crew data from API
  async function loadCrewData() {
    try {
      const token = localStorage.getItem('adminToken');
      if (!token) {
        window.location.href = '/login';
        return;
      }

      const response = await fetch(`${API_URL}/api/admin/crew`, {
        method: 'GET',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
      });

      if (!response.ok) {
        throw new Error(`HTTP error! status: ${response.status}`);
      }

      const result = await response.json();
      crewData = result.data || [];
      
      // Hide skeleton and show content
      hideSkeletonAndShowContent();
      
      renderCrewTable(crewData);
      updateStats(crewData);
    } catch (error) {
      console.error('Error loading crew data:', error);
      
      // Still hide skeleton even on error
      hideSkeletonAndShowContent();
      
      alert('Gagal memuat data crew');
    }
  }

  // Toggle password visibility
  function togglePasswordVisibility() {
    const passwordInput = document.getElementById('crewPassword') as HTMLInputElement;
    const eyeIcon = document.getElementById('eyeIcon');
    
    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      // Change icon to eye-off
      eyeIcon!.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>';
    } else {
      passwordInput.type = 'password';
      // Change icon back to eye
      eyeIcon!.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>';
    }
  }

  // Modal functions
  function openAddCrewModal() {
    const modal = document.getElementById('addCrewModal');
    if (modal) {
      modal.classList.add('active');
      // Reset form
      (document.getElementById('addCrewForm') as HTMLFormElement).reset();
      // Hide conditional fields initially
      document.getElementById('kemitraanGroup')!.style.display = 'none';
      document.getElementById('subBrandGroup')!.style.display = 'none';
      document.getElementById('outletGroup')!.style.display = 'none';
    }
  }

  function closeAddCrewModal() {
    const modal = document.getElementById('addCrewModal');
    if (modal) {
      modal.classList.remove('active');
    }
  }

  // Edit Crew Modal functions
  function openEditCrewModal() {
    const modal = document.getElementById('editCrewModal');
    if (modal) {
      modal.classList.add('active');
    }
  }

  function closeEditCrewModal() {
    const modal = document.getElementById('editCrewModal');
    if (modal) {
      modal.classList.remove('active');
    }
  }

  // Toggle password visibility for edit form
  function toggleEditPasswordVisibility() {
    const passwordInput = document.getElementById('editCrewPassword') as HTMLInputElement;
    const eyeIcon = document.getElementById('editEyeIcon');

    if (passwordInput.type === 'password') {
      passwordInput.type = 'text';
      // Change icon to eye-off
      eyeIcon!.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"></path>';
    } else {
      passwordInput.type = 'password';
      // Change icon back to eye
      eyeIcon!.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>';
    }
  }

  // Handle edit form submission
  async function handleEditCrewSubmit() {
    const form = document.getElementById('editCrewForm') as HTMLFormElement;
    const formData = new FormData(form);

    // Helper function to safely get string values from FormData
    const getStringValue = (key: string): string => {
      const value = formData.get(key);
      return value ? String(value).trim() : '';
    };

    const token = localStorage.getItem('adminToken');
    if (!token) {
      alert('Token tidak ditemukan. Silakan login kembali.');
      return;
    }

    const crewId = getStringValue('crewId');
    if (!crewId) {
      alert('ID crew tidak ditemukan');
      return;
    }

    const crewPayload: any = {
      nama: getStringValue('nama'),
      email: getStringValue('email'),
      divisi: getStringValue('divisi'),
      kemitraan: getStringValue('kemitraan') || null,
      subBrand: getStringValue('subBrand') || null,
      outlet: getStringValue('outlet') || null,
      nomorHP: getStringValue('nomorHP'),
    };

    // Only include password if it's provided
    const password = getStringValue('password');
    if (password) {
      crewPayload.password = password;
    }

    try {
      const response = await fetch(`${API_URL}/api/admin/crew/${crewId}`, {
        method: 'PUT',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(crewPayload),
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Gagal memperbarui crew');
      }

      const result = await response.json();

      // Close modal and reload data
      closeEditCrewModal();
      loadCrewData();

      // Show success message
      alert(`Crew ${result.data.nama} berhasil diperbarui!`);
    } catch (error) {
      console.error('Error updating crew:', error);
      alert(error instanceof Error ? error.message : 'Gagal memperbarui crew');
    }
  }

  // Handle form submission
  async function handleAddCrewSubmit() {
    const form = document.getElementById('addCrewForm') as HTMLFormElement;
    const formData = new FormData(form);

    // Helper function to safely get string values from FormData
    const getStringValue = (key: string): string => {
      const value = formData.get(key);
      return value ? String(value).trim() : '';
    };

    const token = localStorage.getItem('adminToken');
    if (!token) {
      alert('Token tidak ditemukan. Silakan login kembali.');
      return;
    }

    const crewPayload = {
      nama: getStringValue('nama'),
      email: getStringValue('email'),
      password: getStringValue('password'),
      divisi: getStringValue('divisi'),
      kemitraan: getStringValue('kemitraan') || null,
      subBrand: getStringValue('subBrand') || null,
      outlet: getStringValue('outlet') || null,
      nomorHP: getStringValue('nomorHP'),
    };

    try {
      const response = await fetch(`${API_URL}/api/admin/crew/create`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(crewPayload),
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Gagal menambahkan crew');
      }

      const result = await response.json();
      
      // Close modal and reload data
      closeAddCrewModal();
      loadCrewData();

      // Show success message
      alert(`Crew ${result.data.nama} berhasil ditambahkan!`);
    } catch (error) {
      console.error('Error adding crew:', error);
      alert(error instanceof Error ? error.message : 'Gagal menambahkan crew');
    }
  }

  // Global functions for table actions
  async function editCrew(crewId: string) {
    const token = localStorage.getItem('adminToken');
    if (!token) {
      alert('Token tidak ditemukan. Silakan login kembali.');
      return;
    }

    try {
      const response = await fetch(`${API_URL}/api/admin/crew/${crewId}`, {
        method: 'GET',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Gagal mengambil data crew');
      }

      const result = await response.json();
      const crew = result.data;

      // Fill the edit form with crew data
      (document.getElementById('editCrewId') as HTMLInputElement).value = crew._id;
      (document.getElementById('editCrewNama') as HTMLInputElement).value = crew.nama || '';
      (document.getElementById('editCrewEmail') as HTMLInputElement).value = crew.email || '';
      (document.getElementById('editCrewPhone') as HTMLInputElement).value = crew.nomorHP || '';
      (document.getElementById('editCrewDivisi') as HTMLSelectElement).value = crew.divisi || '';
      (document.getElementById('editCrewPassword') as HTMLInputElement).value = ''; // Always empty for security

      // Handle conditional fields
      const divisiSelect = document.getElementById('editCrewDivisi') as HTMLSelectElement;
      const kemitraanGroup = document.getElementById('editKemitraanGroup')!;
      const outletGroup = document.getElementById('editOutletGroup')!;
      const kemitraanSelect = document.getElementById('editCrewKemitraan') as HTMLSelectElement;
      const outletInput = document.getElementById('editCrewOutlet') as HTMLInputElement;

      // Set kemitraan and outlet values first
      kemitraanSelect.value = crew.kemitraan || '';
      outletInput.value = crew.outlet || '';

      // Show/hide conditional fields based on divisi
      if (crew.divisi === 'Crew' || crew.divisi === 'Supervisor') {
        kemitraanGroup.style.display = 'block';
        outletGroup.style.display = 'block';
        kemitraanSelect.required = true;
        outletInput.required = true;
      } else {
        kemitraanGroup.style.display = 'none';
        outletGroup.style.display = 'none';
        kemitraanSelect.required = false;
        outletInput.required = false;
      }

      // Handle sub-brand visibility
      const subBrandGroup = document.getElementById('editSubBrandGroup')!;
      const subBrandSelect = document.getElementById('editCrewSubBrand') as HTMLSelectElement;
      subBrandSelect.value = crew.subBrand || '';

      if (crew.kemitraan === 'RM Nusantara') {
        subBrandGroup.style.display = 'block';
        subBrandSelect.required = true;
      } else {
        subBrandGroup.style.display = 'none';
        subBrandSelect.required = false;
      }

      // Show the modal
      openEditCrewModal();
    } catch (error) {
      console.error('Error loading crew data for edit:', error);
      alert(error instanceof Error ? error.message : 'Gagal memuat data crew untuk edit');
    }
  }

  async function toggleCrewStatus(crewId: string) {
    const token = localStorage.getItem('adminToken');
    if (!token) {
      alert('Token tidak ditemukan. Silakan login kembali.');
      return;
    }

    // Find current crew and toggle status
    const crew = crewData.find(c => c._id === crewId);
    if (!crew) {
      alert('Crew tidak ditemukan');
      return;
    }

    const newStatus = crew.status === 'active' ? 'inactive' : 'active';
    
    try {
      const response = await fetch(`${API_URL}/api/admin/crew/${crewId}/status`, {
        method: 'PATCH',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({ status: newStatus }),
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Gagal mengubah status crew');
      }

      loadCrewData();
      alert(`Status crew berhasil diubah menjadi ${newStatus === 'active' ? 'Aktif' : 'Non-Aktif'}`);
    } catch (error) {
      console.error('Error toggling crew status:', error);
      alert(error instanceof Error ? error.message : 'Gagal mengubah status crew');
    }
  }

  async function deleteCrew(crewId: string) {
    const token = localStorage.getItem('adminToken');
    if (!token) {
      alert('Token tidak ditemukan. Silakan login kembali.');
      return;
    }

    if (!confirm('Apakah Anda yakin ingin menghapus crew ini?')) {
      return;
    }

    try {
      const response = await fetch(`${API_URL}/api/admin/crew/${crewId}`, {
        method: 'DELETE',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
      });

      if (!response.ok) {
        const error = await response.json();
        throw new Error(error.error || 'Gagal menghapus crew');
      }

      loadCrewData();
      alert('Crew berhasil dihapus');
    } catch (error) {
      console.error('Error deleting crew:', error);
      alert(error instanceof Error ? error.message : 'Gagal menghapus crew');
    }
  }

  // Initialize page
  document.addEventListener('DOMContentLoaded', function() {
    if (!checkAuth()) return;

    // Load initial data
    loadCrewData();

    // Add event listeners
    document.getElementById('addCrewBtn')!.addEventListener('click', function() {
      openAddCrewModal();
    });

    document.getElementById('refreshBtn')!.addEventListener('click', function() {
      loadCrewData();
    });

    document.getElementById('searchInput')!.addEventListener('input', function() {
      renderCrewTable(crewData);
    });

    document.getElementById('statusFilter')!.addEventListener('change', function() {
      renderCrewTable(crewData);
    });

    // Form submission
    document.getElementById('addCrewForm')!.addEventListener('submit', function(e) {
      e.preventDefault();
      handleAddCrewSubmit();
