        subBrandSelect.required = false;
        subBrandSelect.value = '';
      }
    });

    // Edit form divisi change handler for conditional fields
    document.getElementById('editCrewDivisi')!.addEventListener('change', function(e) {
      const selectedDivisi = (e.target as HTMLSelectElement).value;
      const kemitraanGroup = document.getElementById('editKemitraanGroup')!;
      const outletGroup = document.getElementById('editOutletGroup')!;
      const kemitraanSelect = document.getElementById('editCrewKemitraan') as HTMLSelectElement;
      const outletInput = document.getElementById('editCrewOutlet') as HTMLInputElement;

      if (selectedDivisi === 'Crew' || selectedDivisi === 'Supervisor') {
        kemitraanGroup.style.display = 'block';
        outletGroup.style.display = 'block';
        kemitraanSelect.required = true;
        outletInput.required = true;
      } else {
        kemitraanGroup.style.display = 'none';
        outletGroup.style.display = 'none';
        kemitraanSelect.required = false;
        outletInput.required = false;
        kemitraanSelect.value = '';
        outletInput.value = '';
        // Also hide sub-brand if it was visible
        document.getElementById('editSubBrandGroup')!.style.display = 'none';
        (document.getElementById('editCrewSubBrand') as HTMLSelectElement).required = false;
        (document.getElementById('editCrewSubBrand') as HTMLSelectElement).value = '';
      }
    });

    // Edit form kemitraan change handler for sub-brand visibility
    document.getElementById('editCrewKemitraan')!.addEventListener('change', function(e) {
      const selectedValue = (e.target as HTMLSelectElement).value;
      const subBrandGroup = document.getElementById('editSubBrandGroup')!;
      const subBrandSelect = document.getElementById('editCrewSubBrand') as HTMLSelectElement;

      if (selectedValue === 'RM Nusantara') {
        subBrandGroup.style.display = 'block';
        subBrandSelect.required = true;
      } else {
        subBrandGroup.style.display = 'none';
        subBrandSelect.required = false;
        subBrandSelect.value = '';
      }
    });
  });

  // Close modal when clicking outside
  window.addEventListener('click', function(event) {
    const addModal = document.getElementById('addCrewModal');
    const editModal = document.getElementById('editCrewModal');
    if (event.target === addModal) {
      closeAddCrewModal();
    }
    if (event.target === editModal) {
      closeEditCrewModal();
    }
  });

  // Attach to window for onclick handlers
  (window as any).openAddCrewModal = openAddCrewModal;
  (window as any).closeAddCrewModal = closeAddCrewModal;
  (window as any).closeEditCrewModal = closeEditCrewModal;
  (window as any).handleAddCrewSubmit = handleAddCrewSubmit;
  (window as any).handleEditCrewSubmit = handleEditCrewSubmit;
  (window as any).editCrew = editCrew;
  (window as any).toggleCrewStatus = toggleCrewStatus;
  (window as any).deleteCrew = deleteCrew;
  (window as any).togglePasswordVisibility = togglePasswordVisibility;
  (window as any).toggleEditPasswordVisibility = toggleEditPasswordVisibility;
</script>