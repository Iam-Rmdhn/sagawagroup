<script>
  // API URL configuration
  const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
  
  // Robust loader for SweetAlert2: try native dynamic import first, fall back to CDN.
  async function loadSweetAlert(): Promise<any> {
    if (typeof window === 'undefined') return null;
    // If already loaded globally, return it
    if ((window as any).Swal) return (window as any).Swal;

    try {
      const mod = await import('sweetalert2');
      const Swal = (mod && mod.default) ? mod.default : mod;
      (window as any).Swal = Swal;
      return Swal;
    } catch (err) {
      // Dynamic import failed (dev server issue). Fallback to CDN script.
      return new Promise((resolve, reject) => {
        if ((window as any).Swal) return resolve((window as any).Swal);

        const script = document.createElement('script');
        script.src = 'https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.all.min.js';
        script.async = true;
        script.onload = () => {
          // sweetalert2 exposes Swal globally
          const Swal = (window as any).Swal || (window as any).swal || (window as any).Sweetalert2;
          if (Swal) {
            (window as any).Swal = Swal;
            resolve(Swal);
          } else {
            // As a last resort try default export-like name
            resolve((window as any).Swal);
          }
        };
        script.onerror = () => reject(new Error('Failed to load SweetAlert2 from CDN'));
        document.head.appendChild(script);
      });
    }
  }
  
