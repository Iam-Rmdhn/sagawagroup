  // Function to update stats with smooth animation
  function updateStats(mitras: any[], isUserMenu: boolean = false) {
    console.log('Updating stats with mitras data:', mitras); // Debug log
    
    // Hide skeleton and show actual content on first data load
    hideSkeletonAndShowContent();
    
    const totalUsers = mitras.length;
    const pendingCount = mitras.filter(m => m.status === 'pending').length;
    const approvedCount = mitras.filter(m => m.status === 'approved').length;
    
    // Calculate DP and FP totals with more flexible filtering
    const dpMitra = mitras.filter(m => {
      // Check multiple possible values for DP
      return m.nilaiPaketUsaha === 'DP' || 
             m.nilaiPaketUsaha === 'Down Payment' || 
             m.paketUsaha === 'DP' ||
             m.paketUsaha === 'Down Payment';
    });
    
    const fpMitra = mitras.filter(m => {
      // Check multiple possible values for Full Payment
      return m.nilaiPaketUsaha === 'Full Payment' || 
             m.nilaiPaketUsaha === 'FP' || 
             m.paketUsaha === 'Full Payment' ||
             m.paketUsaha === 'FP';
    });
    
    console.log('DP Mitra:', dpMitra); // Debug log
    console.log('FP Mitra:', fpMitra); // Debug log
    
    const dpTotal = dpMitra.reduce((sum, m) => sum + (m.yangHarusDibayar || m.nominalDP || m.hargaPaket || 0), 0);
    const fpTotal = fpMitra.reduce((sum, m) => sum + (m.yangHarusDibayar || m.nominalFull || m.hargaPaket || 0), 0);

    // Animate stats updates
    const animateNumber = (element: HTMLElement | null, finalValue: string, duration: number = 800) => {
      if (!element) return;
      
      // Remove loading state
      element.classList.remove('loading-pulse');
      
      // If it's a currency, animate from 0 to final value
      if (finalValue.includes('Rp')) {
        const finalNumber = parseInt(finalValue.replace(/[^\d]/g, ''));
        let currentNumber = 0;
        const increment = finalNumber / (duration / 16); // 60fps
        
        const animate = () => {
          currentNumber += increment;
          if (currentNumber >= finalNumber) {
            element.textContent = finalValue;
          } else {
            element.textContent = formatCurrency(Math.floor(currentNumber));
            requestAnimationFrame(animate);
          }
        };
        animate();
      } else {
        // For regular numbers
        const finalNumber = parseInt(finalValue);
        let currentNumber = 0;
        const increment = finalNumber / (duration / 16);
        
        const animate = () => {
          currentNumber += increment;
          if (currentNumber >= finalNumber) {
            element.textContent = finalValue;
          } else {
            element.textContent = Math.floor(currentNumber).toString();
            requestAnimationFrame(animate);
          }
        };
        animate();
      }
    };

    if (isUserMenu) {
      // Update User stats with animation
      const totalUsersEl = document.getElementById('total-users-user');
      const pendingUserEl = document.getElementById('pending-user');
      
      setTimeout(() => animateNumber(totalUsersEl, totalUsers.toString()), 100);
      setTimeout(() => animateNumber(pendingUserEl, pendingCount.toString()), 200);
    } else {
      // Update Dashboard stats with staggered animation
      const totalUsersEl = document.getElementById('total-users');
      const dpMasukEl = document.getElementById('dp-masuk');
      const fpMasukEl = document.getElementById('fp-masuk');
      const pendingEl = document.getElementById('pending-dashboard');
      
      setTimeout(() => animateNumber(totalUsersEl, totalUsers.toString()), 100);
      setTimeout(() => animateNumber(dpMasukEl, formatCurrency(dpTotal)), 200);
      setTimeout(() => animateNumber(fpMasukEl, formatCurrency(fpTotal)), 300);
      setTimeout(() => animateNumber(pendingEl, pendingCount.toString()), 400);
    }
  }
  
  // Function to update chart with real mitra data (7 days focus)
  function updateChartWithRealData(mitras: any[]) {
    if (!mitras) {
      console.log('No mitra data available');
      return;
    }
    
    // If chart not ready yet, queue the data
    if (!isChartReady || !paymentChart) {
      console.log('Chart not ready yet, queueing data...');
      pendingChartData = mitras;
      return;
    }

    console.log('Updating chart with', mitras.length, 'mitras');

    // Process payment data from mitras
    const dpPayments = mitras.filter(m => 
      (m.nilaiPaketUsaha === 'DP' || m.paketUsaha === 'DP') && m.status === 'approved'
    );
    const fpPayments = mitras.filter(m => 
      (m.nilaiPaketUsaha === 'Full Payment' || m.paketUsaha === 'Full Payment' || 
       m.nilaiPaketUsaha === 'FP' || m.paketUsaha === 'FP') && m.status === 'approved'
    );
    
    console.log('DP Payments:', dpPayments.length, 'FP Payments:', fpPayments.length);
    
    // Create time series data for the last 7 days
    const now = new Date();
    const timeLabels = [];
    const dpData = [];
    const fpData = [];
    
    // Generate daily slots for the last 7 days
    for (let i = 6; i >= 0; i--) {
      const date = new Date(now.getTime() - i * 24 * 60 * 60 * 1000);
      const dateStr = i === 0 ? 'Hari ini' : date.toLocaleDateString('id-ID', { 
        weekday: 'short', 
        day: 'numeric' 
      });
      timeLabels.push(dateStr);
      
      // Count payments for this specific date
      const dpCountForDay = dpPayments.filter(payment => {
        if (payment.createdAt) {
          const paymentDate = new Date(payment.createdAt);
          return paymentDate.toDateString() === date.toDateString();
        }
        return false;
      }).length;
      
      const fpCountForDay = fpPayments.filter(payment => {
        if (payment.createdAt) {
          const paymentDate = new Date(payment.createdAt);
          return paymentDate.toDateString() === date.toDateString();
        }
        return false;
      }).length;
      
      dpData.push(dpCountForDay);
      fpData.push(fpCountForDay);
    }

    console.log('Chart labels:', timeLabels);
    console.log('DP data:', dpData);
    console.log('FP data:', fpData);

    // Calculate totals
    const totalDPAmount = dpPayments.reduce((sum, m) => sum + (m.yangHarusDibayar || m.hargaPaket || 0), 0);
    const totalFPAmount = fpPayments.reduce((sum, m) => sum + (m.yangHarusDibayar || m.hargaPaket || 0), 0);
    const totalDPCount = dpPayments.length;
    const totalFPCount = fpPayments.length;
    
    // Update chart
    paymentChart.data.labels = timeLabels;
    paymentChart.data.datasets[0].data = dpData;
    paymentChart.data.datasets[1].data = fpData;
    
    paymentChart.update('active');

    // Summary cards removed - chart only mode
    
    console.log('Chart updated successfully');
  }

  // Helper function to format currency
  function formatCurrency(amount: number): string {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    }).format(amount);
  }

