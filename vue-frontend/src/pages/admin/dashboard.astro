          paymentChart.resize();
          paymentChart.update();
          
          // Force repaint of container
          const container = canvas.parentElement;
          if (container) {
            container.style.opacity = '0.99';
            container.offsetHeight;
            container.style.opacity = '1';
          }
          
          console.log('🎉 Chart should now be visible!');
        }
      }, 200);

      
