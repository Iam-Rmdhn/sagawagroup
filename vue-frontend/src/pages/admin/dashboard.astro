  // Function to approve/reject mitra
  async function approveMitra(mitraId: string, action: 'approve' | 'reject') {
    const token = localStorage.getItem('adminToken');

    if (!token) {
      window.location.href = '/login';
      return;
    }

    const actionText = action === 'approve' ? 'menyetujui' : 'menolak';
    
    const Swal = await loadSweetAlert();
    const result = await Swal.fire({
      title: `Apakah anda ${actionText} Mitra?`,
      text: `Apakah anda yakin untuk ${actionText} mitra ini?`,
      icon: "question",
      showCancelButton: true,
      confirmButtonColor: "#3085d6",
      cancelButtonColor: "#d33",
      confirmButtonText: "Ya",
      cancelButtonText: "Tidak"
    });

    if (!result.isConfirmed) {
      return;
    }

    try {
      const response = await fetch(`${API_URL}/api/admin/mitra/approve`, {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify({
          mitraId: mitraId,
          action: action
        }),
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // If backend reports email sending status, surface it to admin
        const emailSent = data?.data?.emailSent;
        const emailError = data?.data?.emailError;

        if (action === 'approve' && emailSent === false) {
          const Swal = await loadSweetAlert();
          await Swal.fire({
            title: "Akun dibuat, tetapi email gagal dikirim",
            html: `Akun mitra telah dibuat, namun email kredensial gagal dikirim ke <strong>${data?.data?.email || 'N/A'}</strong>.<br><br>
                   Error: <code>${emailError || 'Tidak diketahui'}</code><br><br>
                   Silakan kirim ulang email secara manual atau periksa konfigurasi email server.`,
            icon: "warning",
            confirmButtonText: 'OK'
          });
        } else {
          const Swal = await loadSweetAlert();
          await Swal.fire({
            title: action === 'approve' ? "Approved!" : "Rejected!",
            text: action === 'approve' ? "Mitra disetujui" : "Mitra ditolak",
            icon: "success"
          });
        }

        // Reload mitra data with current filter
        const activeFilter = getCurrentActiveFilter();
        loadMitraData(activeFilter);
      } else {
        {
          const Swal = await loadSweetAlert();
          Swal.fire({
            title: "Error",
            text: data.error || 'Gagal memproses permintaan',
            icon: "error"
          });
        }
      }
    } catch (error: unknown) {
      console.error('Error approving mitra:', error);
      const errorMessage = error instanceof Error ? error.message : 'Unknown error';
      {
        const Swal = await loadSweetAlert();
        Swal.fire({
          title: "Error",
          text: `Terjadi kesalahan saat memproses permintaan: ${errorMessage}`,
          icon: "error"
        });
      }
    }
  }

  // Function to delete mitra (akan menghapus dari semua tabel terkait)
  async function deleteMitra(mitraId: string, namaMitra: string) {
    const token = localStorage.getItem('adminToken');

    if (!token) {
      window.location.href = '/login';
      return;
    }

    const Swal = await loadSweetAlert();
    const result = await Swal.fire({
      title: "Hapus Mitra?",
      html: `Apakah anda yakin ingin menghapus mitra <strong>${namaMitra}</strong>?<br><br>
               <span class="text-red-600 font-medium">⚠️ Perhatian:</span><br>
               Data akan dihapus dari:<br>
               • Database Mitra<br>
               • Data Pelunasan<br>
               • Semua data terkait lainnya<br><br>
               <span class="text-red-600">Data yang dihapus tidak dapat dikembalikan!</span>`,
      icon: "warning",
      showCancelButton: true,
      confirmButtonColor: "#d33",
      cancelButtonColor: "#3085d6",
      confirmButtonText: "Ya, Hapus Semua",
      cancelButtonText: "Batal"
    });

    if (!result.isConfirmed) {
      return;
    }

    try {
      // Show loading state
      {
        const Swal = await loadSweetAlert();
        Swal.fire({
          title: 'Menghapus data...',
          html: 'Mohon tunggu, sedang menghapus data mitra dari semua database',
          allowOutsideClick: false,
          allowEscapeKey: false,
          didOpen: () => {
            Swal.showLoading();
          }
        });
      }

      // 1. Hapus data mitra utama
      const response = await fetch(`${API_URL}/api/admin/mitra/${mitraId}`, {
        method: 'DELETE',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
      });

      const data = await response.json();

      if (response.ok && data.success) {
        // 2. Hapus data pelunasan terkait (jika ada)
        try {
          const pelunasanResponse = await fetch(`${API_URL}/api/admin/mitra_pelunasan/by-mitra/${mitraId}`, {
            method: 'DELETE',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          });
          
          // Log pelunasan deletion result, tapi tidak block proses jika tidak ada data
          if (pelunasanResponse.ok) {
            const pelunasanData = await pelunasanResponse.json();
            console.log('Pelunasan data deleted:', pelunasanData);
          }
        } catch (pelunasanError) {
          console.warn('No pelunasan data to delete or error:', pelunasanError);
          // Continue execution - pelunasan data mungkin tidak ada
        }

        {
          const Swal = await loadSweetAlert();
          Swal.fire({
            title: "Terhapus!",
            html: `Data mitra <strong>${namaMitra}</strong> telah dihapus dari semua database`,
            icon: "success",
            confirmButtonColor: "#10b981"
          });
        }
        
        // Reload mitra data with current filter
        const activeFilter = getCurrentActiveFilter();
        loadMitraData(activeFilter);
      } else {
        {
          const Swal = await loadSweetAlert();
          Swal.fire({
            title: "Error",
            text: data.message || 'Gagal menghapus data mitra',
            icon: "error"
          });
        }
      }
    } catch (error: unknown) {
      console.error('Error deleting mitra:', error);
      const errorMessage = error instanceof Error ? error.message : 'Unknown error';
      {
        const Swal = await loadSweetAlert();
        Swal.fire({
          title: "Error",
          text: `Terjadi kesalahan saat menghapus data mitra: ${errorMessage}`,
          icon: "error"
        });
      }
    }
  }

