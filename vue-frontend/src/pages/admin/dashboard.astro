  function startRealTimeUpdates() {
    updateChartDataFromAPI();
    // Update every 60 seconds for real-time data
    chartUpdateInterval = setInterval(updateChartDataFromAPI, 60000);
  }

  async function updateChartDataFromAPI() {
    try {
      console.log('Fetching mitra data for chart...');
      const token = localStorage.getItem('adminToken');
      if (!token) {
        console.error('No admin token found');
        return;
      }

      const response = await fetch(`${API_URL}/api/admin/mitra`, {
        method: 'GET',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json'
        }
      });

      if (response.ok) {
        const result = await response.json();
        console.log('Mitra data fetched:', result);
        if (result.success && result.data) {
          updateChartWithRealData(result.data);
        } else {
          console.warn('No data in response');
        }
      } else {
        console.error('Failed to fetch mitra data for chart:', response.status);
      }
    } catch (error) {
      console.error('Error fetching mitra data for chart:', error);
    }
  }

  function formatRupiah(amount: number): string {
    return new Intl.NumberFormat('id-ID', {
      style: 'currency',
      currency: 'IDR',
      minimumFractionDigits: 0,
      maximumFractionDigits: 0
    }).format(amount);
  }

  // Visitor Analytics Functions with AstraDB Integration
  let visitorUpdateInterval: NodeJS.Timeout | null = null;

  async function updateVisitorStats() {
    try {
      const token = localStorage.getItem('token');
      if (!token) {
        // Silently skip if no token (user not logged in as admin)
        console.debug('[Visitor] No admin token, skipping stats update');
        return;
      }

      const response = await fetch(`${API_URL}/api/visitor/stats`, {
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
      });

      if (response.ok) {
        const data = await response.json();
        
        // Helper function to animate number
        const animateNumber = (element: HTMLElement | null, newValue: number) => {
          if (!element) return;
          element.classList.remove('loading-pulse');
          
          const currentValue = parseInt(element.textContent || '0');
          if (currentValue !== newValue) {
            const duration = 500;
            const increment = (newValue - currentValue) / (duration / 16);
            let current = currentValue;
            
            const animate = () => {
              current += increment;
              if ((increment > 0 && current >= newValue) || (increment < 0 && current <= newValue)) {
                element.textContent = newValue.toLocaleString('id-ID');
              } else {
                element.textContent = Math.floor(current).toLocaleString('id-ID');
                requestAnimationFrame(animate);
              }
            };
            animate();
          } else {
            element.textContent = newValue.toLocaleString('id-ID');
          }
        };
        
        // Update today visitors
        const visitorsTodayEl = document.getElementById('visitors-today');
        animateNumber(visitorsTodayEl, data.today || 0);
        
        // Update week visitors
        const visitorsWeekEl = document.getElementById('visitors-week');
        animateNumber(visitorsWeekEl, data.thisWeek || 0);
        
        // Update month visitors
        const visitorsMonthEl = document.getElementById('visitors-month');
        animateNumber(visitorsMonthEl, data.thisMonth || 0);
        
        console.log('[Visitor] Stats updated from AstraDB:', data);
      } else if (response.status === 401 || response.status === 403) {
        console.log('[Visitor] Unauthorized, clearing token');
        // Don't clear token here, just skip update
      }
    } catch (error) {
      console.error('[Visitor] Error fetching visitor stats:', error);
      // Set default values if API fails
      const visitorsTodayEl = document.getElementById('visitors-today');
      const visitorsWeekEl = document.getElementById('visitors-week');
      const visitorsMonthEl = document.getElementById('visitors-month');
      
      if (visitorsTodayEl) {
        visitorsTodayEl.classList.remove('loading-pulse');
        visitorsTodayEl.textContent = '0';
      }
      if (visitorsWeekEl) {
        visitorsWeekEl.classList.remove('loading-pulse');
        visitorsWeekEl.textContent = '0';
      }
      if (visitorsMonthEl) {
        visitorsMonthEl.classList.remove('loading-pulse');
        visitorsMonthEl.textContent = '0';
      }
    }
  }

  function startVisitorTracking() {
    // Check if user is logged in before starting
    const token = localStorage.getItem('token');
    if (!token) {
      console.debug('[Visitor] No admin token found, visitor stats disabled');
      return;
    }
    
    // Initial update
    updateVisitorStats();
    
    // Update every 10 seconds
    visitorUpdateInterval = setInterval(updateVisitorStats, 10000);
    
    console.log('[Visitor] ✅ Started visitor stats tracking (updates every 10s)');
  }

  function stopVisitorTracking() {
    if (visitorUpdateInterval) {
      clearInterval(visitorUpdateInterval);
      visitorUpdateInterval = null;
      console.log('[Visitor] Stopped visitor tracking');
    }
  }
  
  // Initialize chart when DOM is ready
  function tryInitializeChart(attempt: number = 1) {
    const maxAttempts = 15;
    
    if (attempt > maxAttempts) {
      console.error('❌ Failed to initialize chart after', maxAttempts, 'attempts');
      console.error('Debug info:');
      console.error('- Canvas exists:', !!document.getElementById('paymentChart'));
      console.error('- Chart.js loaded:', typeof (window as any).Chart !== 'undefined');
      console.error('- Chart.js flag:', (window as any).chartJsLoaded);
      return;
    }
    
    const canvas = document.getElementById('paymentChart') as HTMLCanvasElement;
    if (!canvas) {
      console.log('⏳ Canvas not found, retry', attempt, 'of', maxAttempts);
      setTimeout(() => tryInitializeChart(attempt + 1), 150);
      return;
    }
    
    // Check Chart.js availability with multiple conditions
    if (typeof (window as any).Chart === 'undefined' || !(window as any).chartJsLoaded) {
      console.log('⏳ Chart.js not fully ready, retry', attempt, 'of', maxAttempts);
      setTimeout(() => tryInitializeChart(attempt + 1), 150);
      return;
    }
    
    // Check if canvas is visible and has proper dimensions
    const canvasDisplay = window.getComputedStyle(canvas).display;
    const canvasWidth = canvas.offsetWidth;
    const canvasHeight = canvas.offsetHeight;
    const canvasRect = canvas.getBoundingClientRect();
    
    console.log('Canvas check attempt', attempt, ':', {
      display: canvasDisplay,
      offsetWidth: canvasWidth,
      offsetHeight: canvasHeight,
      boundingWidth: canvasRect.width,
      boundingHeight: canvasRect.height,
      attributeWidth: canvas.getAttribute('width'),
      attributeHeight: canvas.getAttribute('height'),
      parent: canvas.parentElement?.className
    });
    
    // Use attribute dimensions if offset dimensions are not available
    const effectiveWidth = canvasWidth || parseInt(canvas.getAttribute('width') || '0');
    const effectiveHeight = canvasHeight || parseInt(canvas.getAttribute('height') || '0');
    
    if (canvasDisplay === 'none' || (effectiveWidth === 0 && effectiveHeight === 0)) {
      console.log('⏳ Canvas not visible or has no dimensions, retry', attempt, 'of', maxAttempts);
      setTimeout(() => tryInitializeChart(attempt + 1), 150);
      return;
    }
    
    console.log('✅ All conditions met, initializing chart on attempt', attempt);
    console.log('Chart.js version:', (window as any).Chart?.version);
    initializePaymentChart();
  }
  
  // Multiple initialization attempts for better reliability
  function startChartInitialization() {
    console.log('🚀 Starting chart initialization sequence...');
    
    // Immediate attempt
    tryInitializeChart();
    
    // Backup attempts
    setTimeout(() => {
      if (!isChartReady) {
        console.log('🔄 Backup attempt 1...');
        tryInitializeChart();
      }
    }, 200);
    
    setTimeout(() => {
      if (!isChartReady) {
        console.log('🔄 Backup attempt 2...');
        tryInitializeChart();
      }
    }, 500);
    
    setTimeout(() => {
      if (!isChartReady) {
        console.log('🔄 Final backup attempt...');
        tryInitializeChart();
      }
    }, 1000);
  }
  
  // Check if we're on admin dashboard before starting visitor tracking
  const currentPath = window.location.pathname;
  const isAdminDashboard = currentPath === '/admin/dashboard';
  
  console.log('[Dashboard] Current path:', currentPath);
  console.log('[Dashboard] Is admin dashboard:', isAdminDashboard);
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      console.log('📄 DOM loaded, initializing chart...');
      setTimeout(startChartInitialization, 100);
      
      // Only start visitor tracking on admin dashboard
      if (isAdminDashboard) {
        console.log('📊 Admin dashboard detected, will start visitor tracking...');
        setTimeout(startVisitorTracking, 700);
      } else {
        console.log('📊 Not admin dashboard, skipping visitor tracking');
      }
    });
  } else {
    // DOM is already loaded
    console.log('📄 DOM already loaded, initializing chart now...');
    setTimeout(startChartInitialization, 100);
    
    // Only start visitor tracking on admin dashboard
    if (isAdminDashboard) {
      console.log('📊 Admin dashboard detected, will start visitor tracking...');
      setTimeout(startVisitorTracking, 700);
    } else {
      console.log('📊 Not admin dashboard, skipping visitor tracking');
    }
  }

  window.addEventListener('beforeunload', function() {
    if (chartUpdateInterval) {
      clearInterval(chartUpdateInterval);
    }
    if (isAdminDashboard) {
      stopVisitorTracking();
    }
  });
</script>
