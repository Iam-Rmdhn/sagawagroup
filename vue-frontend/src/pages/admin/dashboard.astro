  // Function to show mitra detail modal
  async function showMitraDetail(mitraId: string) {
    const token = localStorage.getItem('adminToken');
    const modal = document.getElementById('mitraDetailModal');
    const content = document.getElementById('mitraDetailContent');

    if (!token || !modal || !content) {
      return;
    }

    try {
      // Show modal first
      modal.classList.remove('hidden');
      content.innerHTML = '<div class="col-span-2 text-center">Loading...</div>';

      const response = await fetch(`${API_URL}/api/admin/mitra/${mitraId}`, {
        method: 'GET',
        headers: {
          'Authorization': `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
      });

      if (!response.ok) {
        throw new Error('Failed to fetch mitra detail');
      }

      const result = await response.json();

      if (result.success && result.data) {
        const mitra = result.data;
        await displayMitraDetail(mitra);
      } else {
        content.innerHTML = '<div class="col-span-2 text-center text-red-500">Error loading detail</div>';
      }
    } catch (error: unknown) {
      console.error('Error loading mitra detail:', error);
      const errorMessage = error instanceof Error ? error.message : 'Unknown error';
      content.innerHTML = `<div class="col-span-2 text-center text-red-500">Error: ${errorMessage}</div>`;
    }
  }

  // Function to display mitra detail in modal
  async function displayMitraDetail(mitra: any) {
    const content = document.getElementById('mitraDetailContent');
    if (!content) return;

    const formatCurrency = (amount: number) => {
      return new Intl.NumberFormat('id-ID', {
        style: 'currency',
        currency: 'IDR'
      }).format(amount);
    };

    const formatDate = (dateString: string) => {
      return new Date(dateString).toLocaleDateString('id-ID', {
        year: 'numeric',
        month: 'long',
        day: 'numeric',
        hour: '2-digit',
        minute: '2-digit'
      });
    };

    const getStatusBadgeClass = (status: string) => {
      switch(status) {
        case 'pending':
          return 'bg-yellow-100 text-yellow-800 border-yellow-200';
        case 'approved':
          return 'bg-green-100 text-green-800 border-green-200';
        case 'rejected':
          return 'bg-red-100 text-red-800 border-red-200';
        default:
          return 'bg-gray-100 text-gray-800 border-gray-200';
      }
    };

    // Helper function to process image data for display
    const processImageData = (imageData: string | undefined): string => {
      if (!imageData || imageData === '') return '';
      
      // If already a data URL, return as is
      if (imageData.startsWith('data:')) return imageData;
      
      // If it's a URL, normalize uploads domain to current API_URL
      if (imageData.startsWith('http://') || imageData.startsWith('https://')) {
        try {
          const parsed = new URL(imageData);
          if (parsed.pathname.startsWith('/uploads/')) {
            return `${API_URL}${parsed.pathname}`;
          }
        } catch (error) {
          console.warn('[Dashboard] Failed to normalize image URL', error);
        }
        return imageData;
      }
      
      // If it's a file path
      if (imageData.startsWith('/uploads/')) return `${API_URL}${imageData}`;
      
      // If it looks like base64 (long string without dots or slashes)
      if (imageData.length > 100 && !imageData.includes('.') && !imageData.includes('/')) {
        return `data:image/jpeg;base64,${imageData}`;
      }
      
      // Default: treat as filename in uploads folder
      return `${API_URL}/uploads/${imageData}`;
    };

    // PRIORITY: Use new upload_ktp and upload_tf fields first, fallback to legacy fields
    const ktpImage = mitra.upload_ktp || mitra.fotoKTP;
    const tfImage = mitra.upload_tf || mitra.buktiTransfer;

    // Log image data for debugging
    console.log('Image data in mitra object:');
    console.log('upload_ktp (NEW):', mitra.upload_ktp || 'NOT SET');
    console.log('upload_tf (NEW):', mitra.upload_tf || 'NOT SET');
    console.log('fotoKTP (legacy):', mitra.fotoKTP || 'EMPTY');
    console.log('buktiTransfer (legacy):', mitra.buktiTransfer || 'EMPTY');
    console.log('Using KTP:', ktpImage || 'NONE');
    console.log('Using TF:', tfImage || 'NONE');
    console.log('KTP (processed):', processImageData(ktpImage));
    console.log('TF (processed):', processImageData(tfImage));

    // ENHANCED: Determine payment/pelunasan status with comprehensive logic
    let pelunasanStatusHTML = '';
    
    // Helper function to parse numeric values
    const parseNumeric = (value: any): number => {
      if (value === null || value === undefined || value === '') return 0;
      if (typeof value === 'number') return value;
      if (typeof value === 'string') {
        const cleaned = value.replace(/\./g, '').replace(',', '.');
        const parsed = parseFloat(cleaned);
        return isNaN(parsed) ? 0 : parsed;
      }
      return 0;
    };

    const kekurangan = parseNumeric(mitra.kekurangan);
    const hargaPaket = parseNumeric(mitra.hargaPaket);
    const totalPaid = parseNumeric(mitra.totalPaid || mitra.yangHarusDibayar || 0);
    
    console.log('[PELUNASAN DEBUG] Payment analysis:', {
      email: mitra.email,
      nilaiPaketUsaha: mitra.nilaiPaketUsaha,
      kekurangan,
      hargaPaket,
      totalPaid,
      pelunasanApproved: mitra.pelunasanApproved,
      statusPelunasan: mitra.statusPelunasan
    });

    // FIXED: Determine payment status with correct priority order
    // Priority: DP package MUST check database first, then other validations
    let isPaidOff = false;
    let statusReason = '';

    console.log('[PELUNASAN DEBUG] Starting payment status check for:', {
      email: mitra.email,
      nilaiPaketUsaha: mitra.nilaiPaketUsaha,
      kekurangan,
      hargaPaket,
      pelunasanApproved: mitra.pelunasanApproved
    });

    // Check 1: Full Payment package = automatically lunas
    if (mitra.nilaiPaketUsaha === 'Full Payment' || 
        String(mitra.nilaiPaketUsaha || '').toLowerCase().includes('full')) {
      isPaidOff = true;
      statusReason = 'Full Payment package';
      console.log('[PELUNASAN DEBUG] ✅ Check 1: Full Payment package');
    }
    // Check 2: DP Package - MUST check pelunasan database FIRST
    // This is CRITICAL: DP users must submit pelunasan form to be considered LUNAS
    else if (mitra.nilaiPaketUsaha === 'DP') {
      console.log('[PELUNASAN DEBUG] 🔍 Check 2: DP package - checking database...');
      
      try {
        const token = localStorage.getItem('adminToken');
        const pelunasanResponse = await fetch(`${API_URL}/api/admin/mitra_pelunasan`, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${token}`,
            'Content-Type': 'application/json',
          },
        });

        if (pelunasanResponse.ok) {
          const pelunasanResult = await pelunasanResponse.json();
          if (pelunasanResult.success && pelunasanResult.data) {
            // Find pelunasan by email or mitraId
            const pelunasan = pelunasanResult.data.find((p: any) => 
              p.email === mitra.email || p.mitraId === mitra._id
            );

            if (pelunasan) {
              console.log('[PELUNASAN DEBUG] Found pelunasan record:', {
                email: pelunasan.email,
                statusPelunasan: pelunasan.statusPelunasan,
                approved: pelunasan.approved,
                pelunasanApproved: pelunasan.pelunasanApproved,
                nominalPelunasan: pelunasan.nominalPelunasan
              });
              
              // CRITICAL FIX: Check if admin has approved the pelunasan
              // Backend sets statusPelunasan='lunas' when admin approves via /api/admin/approve-pelunasan
              // Also check for alternative approved flags
              const isApprovedByAdmin = (
                pelunasan.statusPelunasan === 'lunas' ||      // Set by admin approval
                pelunasan.statusPelunasan === 'approved' ||   // Alternative status
                pelunasan.approved === true ||                // Direct flag
                pelunasan.pelunasanApproved === true ||       // Alternative flag
                pelunasan.isApproved === true                 // Alternative flag
              );
              
              // Additional validation: Check if there's actual payment data
              const hasPaymentData = (
                pelunasan.nominalPelunasan > 0 ||
                pelunasan.jumlahPelunasan > 0 ||
                pelunasan.buktiTransfer
              );
              
              if (isApprovedByAdmin && hasPaymentData) {
                isPaidOff = true;
                statusReason = 'Pelunasan approved by admin';
                console.log('[PELUNASAN DEBUG] ✅ DP: Pelunasan approved with payment data');
              } else if (isApprovedByAdmin && !hasPaymentData) {
                // Approved but no payment data - suspicious, mark as BELUM LUNAS
                isPaidOff = false;
                statusReason = 'Pelunasan approved but no payment data';
                console.log('[PELUNASAN DEBUG] ⚠️ DP: Approved but no payment data - marking as BELUM LUNAS');
              } else {
                isPaidOff = false;
                statusReason = `Pelunasan ${pelunasan.statusPelunasan || 'pending'} - waiting approval`;
                console.log('[PELUNASAN DEBUG] ❌ DP: Pelunasan submitted but not approved');
              }
            } else {
              // No pelunasan record found - definitely BELUM LUNAS
              isPaidOff = false;
              statusReason = 'Belum submit pelunasan';
              console.log('[PELUNASAN DEBUG] ❌ DP: No pelunasan record found');
            }
          }
        } else {
          // API error - default to BELUM LUNAS for safety
          isPaidOff = false;
          statusReason = 'Error checking pelunasan';
          console.error('[PELUNASAN DEBUG] ❌ API error:', pelunasanResponse.status);
        }
      } catch (error) {
        console.error('[PELUNASAN DEBUG] ❌ Error checking pelunasan:', error);
        // On error, default to BELUM LUNAS for DP package (safer)
        isPaidOff = false;
        statusReason = 'Error checking pelunasan';
      }
    }
    // Check 3: Pelunasan explicitly approved in mitra record
    else if (mitra.pelunasanApproved === true || 
             mitra.statusPelunasan === 'lunas' ||
             mitra.statusPelunasan === 'approved') {
      isPaidOff = true;
      statusReason = 'Pelunasan approved in record';
      console.log('[PELUNASAN DEBUG] ✅ Check 3: Pelunasan approved flag');
    }
    // Check 4: Kekurangan is zero AND harga paket exists
    // Only check this for non-DP packages
    else if (kekurangan <= 0 && hargaPaket > 0) {
      isPaidOff = true;
      statusReason = 'Kekurangan = 0';
      console.log('[PELUNASAN DEBUG] ✅ Check 4: Kekurangan is zero');
    }
    // Check 5: Total paid >= package price
    else if (totalPaid >= hargaPaket && hargaPaket > 0) {
      isPaidOff = true;
      statusReason = 'Total paid >= harga paket';
      console.log('[PELUNASAN DEBUG] ✅ Check 5: Total paid sufficient');
    }
    // Default: BELUM LUNAS
    else {
      isPaidOff = false;
      statusReason = 'Pembayaran belum lengkap';
      console.log('[PELUNASAN DEBUG] ❌ Default: Not paid off');
    }

    console.log('[PELUNASAN DEBUG] 🎯 Final status:', { 
      isPaidOff, 
      statusReason,
      nilaiPaketUsaha: mitra.nilaiPaketUsaha
    });

    // Generate status HTML based on isPaidOff
