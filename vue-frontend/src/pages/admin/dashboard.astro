          <div class="info-item flex flex-col sm:flex-row sm:justify-between sm:items-center">
            <span class="font-medium text-gray-700">Status:</span>
            <span class="status-badge border ${getStatusBadgeClass(mitra.status || 'pending')}">
              ${(mitra.status || 'pending').toUpperCase()}
