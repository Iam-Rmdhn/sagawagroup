  function isBase64OrDataUrl(str: string): boolean {
    if (!str) return false;
    // Cek jika string dimulai dengan data URL
    if (str.startsWith('data:')) return true;
    if (str.length > 50) return true;
    return false;
  }

  // Function to open image modal
  function openImageModal(imageData: string, title: string) {
    const modal = document.getElementById('imageModal');
    const image = document.getElementById('modalImage') as HTMLImageElement;
    const titleElement = document.getElementById('modalImageTitle');
    
    if (modal && image && titleElement) {
      console.log('Opening image modal for:', title);
      console.log('Image data format:', imageData ? imageData.substring(0, 50) + '...' : 'empty');
      
      // Show modal first
      modal.classList.remove('hidden');
      
      // Handle different image data formats
      let imageSrc = '';
      
      if (!imageData || imageData === '') {
        console.error('No image data provided');
        imageSrc = '';
      } else if (imageData.startsWith('data:')) {
        // Already a complete data URL
        imageSrc = imageData;
        console.log('✓ Using existing data URL');
      } else if (imageData.startsWith('http://') || imageData.startsWith('https://')) {
        // It's a URL
        imageSrc = imageData;
        console.log('✓ Using HTTP URL');
      } else if (imageData.startsWith('/uploads/')) {
        // It's a file path, construct URL
        imageSrc = `${API_URL}${imageData}`;
        console.log('✓ Constructed URL from path:', imageSrc);
      } else if (imageData.length > 100 && !imageData.includes('.') && !imageData.includes('/')) {
        // Likely base64 without prefix
        // Try to detect image type from first bytes
        if (imageData.startsWith('/9j/') || imageData.startsWith('iVBOR')) {
          imageSrc = `data:image/jpeg;base64,${imageData}`;
          console.log('✓ Added JPEG data URL prefix to base64');
        } else {
          imageSrc = `data:image/jpeg;base64,${imageData}`;
          console.log('✓ Added default data URL prefix to base64');
        }
      } else {
        // Unknown format, try as filename in uploads folder
        imageSrc = `${API_URL}/uploads/${imageData}`;
        console.log('⚠ Unknown format, trying as filename:', imageSrc);
      }
      
      image.src = imageSrc;
      image.alt = title;
      titleElement.textContent = title;
      
      // Clear any previous error messages
      const existingError = image.parentElement?.querySelector('.error-message');
      if (existingError) existingError.remove();
      image.style.display = 'block';
      
      image.onload = function() {
        console.log('✅ Image loaded successfully');
      };
      
      image.onerror = function() {
        console.error('❌ Failed to load image');
        console.error('   Image src:', imageSrc.substring(0, 100));
        console.error('   Original data:', imageData.substring(0, 100));
        
        titleElement.textContent = title + ' (Gagal memuat gambar)';
        image.style.display = 'none';
        
        const errorMsg = document.createElement('div');
        errorMsg.className = 'error-message text-white text-center p-8';
        errorMsg.innerHTML = `
          <div class="text-red-500 bg-white p-4 rounded">
            <svg class="w-12 h-12 mx-auto mb-3 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <p class="text-lg font-semibold">Gagal memuat gambar</p>
            <p class="text-sm mt-2 text-gray-600">Format gambar tidak didukung atau data rusak</p>
            <p class="text-xs mt-2 text-gray-500">Format: ${imageData.substring(0, 30)}...</p>
          </div>
        `;
        image.parentElement?.appendChild(errorMsg);
      };
    }
  }

