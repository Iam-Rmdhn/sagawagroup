---
// Admin - Mitra Disetujui
import Layout from '../../../layouts/Layout.astro';
import AdminSidebar from '../../../components/admin/sidebar/AdminSidebar.astro';
import AdminNavbar from '../../../components/admin/navbar/AdminNavbar.astro';
import UserTable from '../../../components/admin/UserTable.astro';
---

<Layout title="Mitra Disetujui - Admin Dashboard">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
  <style>
    * {
      transform: translateZ(0);
      will-change: auto;
    }
    
    body, html {
      overflow-x: hidden;
      scroll-behavior: smooth;
    }
    
    /* Skeleton Loading Animations */
    @keyframes shimmer {
      0% {
        background-position: -1000px 0;
      }
      100% {
        background-position: 1000px 0;
      }
    }
    
    .skeleton {
      background: linear-gradient(
        90deg,
        #f0f0f0 0%,
        #e0e0e0 20%,
        #f0f0f0 40%,
        #f0f0f0 100%
      );
      background-size: 1000px 100%;
      animation: shimmer 1.5s linear infinite;
      border-radius: 4px;
    }
    
    .skeleton-card {
      background: white;
      border-radius: 0.75rem;
      padding: 1.5rem;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
    }
    
    .skeleton-text {
      height: 0.875rem;
      margin-bottom: 0.5rem;
    }
    
    .skeleton-title {
      height: 2.25rem;
      margin-bottom: 0.5rem;
    }
    
    .skeleton-table-row {
      height: 4rem;
      margin-bottom: 0.5rem;
    }
    
    .content-hidden {
      display: none;
    }
    
    .skeleton-header {
      background: linear-gradient(
        90deg,
        rgba(21, 128, 61, 0.3) 0%,
        rgba(22, 101, 52, 0.3) 20%,
        rgba(21, 128, 61, 0.3) 40%,
        rgba(21, 128, 61, 0.3) 100%
      );
      background-size: 1000px 100%;
      animation: shimmer 1.5s linear infinite;
      border-radius: 1rem;
      padding: 1.5rem;
      margin-bottom: 1.5rem;
    }
  </style>

  <!-- Admin Navbar -->
  <AdminNavbar />

  <!-- Admin Sidebar -->
  <AdminSidebar currentPage="users" />

  <!-- Main Content -->
  <div class="p-4 sm:ml-0">
    <div class="p-4 mt-14">
      <!-- Skeleton Header -->
      <div id="skeleton-header" class="skeleton-header mt-3 mb-6">
        <div class="flex items-center space-x-3 mb-2">
          <div class="skeleton skeleton-circle" style="width: 3rem; height: 3rem;"></div>
          <div class="flex-1">
            <div class="skeleton skeleton-title w-52 mb-2" style="background: rgba(255, 255, 255, 0.5);"></div>
            <div class="skeleton skeleton-text w-64" style="background: rgba(255, 255, 255, 0.4);"></div>
          </div>
        </div>
      </div>
      
      <!-- Page Header -->
      <div id="actual-header" class="mt-3 mb-6 content-hidden">
        <div class="bg-gradient-to-r from-green-800 to-green-500 rounded-2xl p-6 text-white shadow-2xl">
            <div class="flex items-center space-x-3 mb-2">
            <div class="w-12 h-12 mr-2 flex items-center justify-center">
                <svg class="w-12 h-12" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
                    <path d="m9 14 2 2 4-4"/>
                </svg>
            </div>
            <div>
                <h1 class="text-3xl font-black text-white">Mitra Sagawa Disetujui</h1>
                <p class="text-sm text-green-100 mt-1">Daftar mitra yang telah mendapat persetujuan</p>
            </div>
            </div>
      </div>
      </div>

      <!-- Stats Card -->
      <div id="skeleton-stats" class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <!-- Skeleton Stats -->
        <div class="skeleton-card">
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <div class="skeleton skeleton-text w-32 mb-2"></div>
              <div class="skeleton skeleton-title w-20 mb-2"></div>
              <div class="skeleton skeleton-text w-40"></div>
            </div>
            <div class="skeleton" style="width: 4rem; height: 4rem; border-radius: 50%;"></div>
          </div>
        </div>
        <div class="skeleton-card">
          <div class="flex items-center justify-between">
            <div class="flex-1">
              <div class="skeleton skeleton-text w-24 mb-2"></div>
              <div class="skeleton skeleton-title w-16 mb-2"></div>
              <div class="skeleton skeleton-text w-48"></div>
            </div>
            <div class="skeleton" style="width: 4rem; height: 4rem; border-radius: 50%;"></div>
          </div>
        </div>
      </div>
      
      <!-- Actual Stats Card -->
      <div id="actual-stats" class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8 content-hidden">
        <div class="bg-gradient-to-br from-green-50 to-emerald-100 rounded-xl p-6 shadow-lg border border-green-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-green-600 mb-1">Total Mitra Aktif</p>
              <p id="approved-count" class="text-4xl font-bold text-green-900">-</p>
              <p class="text-xs text-green-600 mt-2">Mitra yang sudah disetujui</p>
            </div>
            <div class="w-16 h-16 flex items-center justify-center">
              <svg class="w-10 h-10 text-green-900" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-user-check-icon lucide-user-check"><path d="m16 11 2 2 4-4"/><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
            </div>
          </div>
        </div>

        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6 shadow-lg border border-blue-200">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-sm font-medium text-blue-600 mb-1">Status</p>
              <p class="text-2xl font-bold text-blue-900">Aktif</p>
              <p class="text-xs text-blue-600 mt-2">Semua mitra dalam status aktif</p>
            </div>
            <div class="w-16 h-16 flex items-center justify-center">
              <svg class="w-1- h-10 text-blue-900" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 10a8 8 0 018-8v8h8a8 8 0 11-16 0z"></path>
                <path d="M12 2.252A8.014 8.014 0 0117.748 8H12V2.252z"></path>
              </svg>
            </div>
          </div>
        </div>
      </div>

      <!-- User Table -->
      <UserTable />
    </div>
  </div>

  <!-- Modal untuk Detail Mitra -->
  <div id="mitraDetailModal" class="modal-detail hidden fixed inset-0 z-50 overflow-y-auto">
    <div class="flex items-center justify-center min-h-screen p-4">
      <div class="fixed inset-0 bg-black bg-opacity-50 backdrop-blur-sm transition-opacity" onclick="closeMitraDetailModal()"></div>
      
      <div class="modal-panel relative bg-white rounded-xl shadow-2xl max-w-4xl w-full">
        <div class="modal-header bg-gradient-to-r from-green-50 to-emerald-50 px-6 py-4 border-b border-green-100 rounded-t-xl">
          <div class="flex justify-between items-center">
            <h3 class="text-xl font-bold text-gray-900">Detail Mitra Disetujui</h3>
            <button onclick="closeMitraDetailModal()" class="text-gray-400 hover:text-gray-600 p-2 rounded-full transition-all">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>
        </div>
        
        <div class="modal-detail-content p-6">
          <div id="mitraDetailContent"></div>
        </div>
        
        <div class="modal-footer bg-gray-50 px-6 py-4 border-t border-gray-100 rounded-b-xl flex justify-end">
          <button onclick="closeMitraDetailModal()" class="px-4 py-2 bg-gray-500 hover:bg-gray-600 text-white rounded-lg transition-colors">
            Tutup
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  import { loadMitraData, renderTableRows, deleteMitra as deleteMitraAPI, getMitraDetail, checkAdminAuth } from '../../../lib/adminHelpers';

  if (!checkAdminAuth()) {
    throw new Error('Authentication required');
  }

  document.addEventListener('DOMContentLoaded', async () => {
    await loadData();
    
    // Update table title
    const tableTitle = document.getElementById('table-title');
    const tableDesc = document.getElementById('table-description');
    if (tableTitle) tableTitle.textContent = 'Mitra Disetujui';
    if (tableDesc) tableDesc.textContent = 'Daftar mitra yang telah mendapat persetujuan dan aktif';
  });

  const refreshBtn = document.getElementById('refresh-btn');
  if (refreshBtn) {
    refreshBtn.addEventListener('click', async () => {
      await loadData();
    });
  }

  async function loadData() {
    try {
      const tableBody = document.getElementById('mitra-table-body');
      if (!tableBody) return;

      tableBody.innerHTML = '<tr><td colspan="7" class="px-6 py-4 text-center text-gray-500">Loading...</td></tr>';

      const mitras = await loadMitraData('approved');

      // Hide skeleton and show actual content
      const skeletonHeader = document.getElementById('skeleton-header');
      const actualHeader = document.getElementById('actual-header');
      const skeletonStats = document.getElementById('skeleton-stats');
      const actualStats = document.getElementById('actual-stats');
      
      if (skeletonHeader) skeletonHeader.style.display = 'none';
      if (actualHeader) actualHeader.classList.remove('content-hidden');
      if (skeletonStats) skeletonStats.style.display = 'none';
      if (actualStats) actualStats.classList.remove('content-hidden');

      document.getElementById('approved-count')!.textContent = mitras.length.toString();

      renderTableRows(mitras, tableBody);
    } catch (error) {
      console.error('Error loading data:', error);
      const tableBody = document.getElementById('mitra-table-body');
      if (tableBody) {
        tableBody.innerHTML = '<tr><td colspan="7" class="px-6 py-4 text-center text-red-500">Error loading data</td></tr>';
      }
    }
  }

  (window as any).viewMitraDetail = async (mitraId: string) => {
    const mitra = await getMitraDetail(mitraId);
    if (mitra) {
      showMitraDetailModal(mitra);
    }
  };

  (window as any).deleteMitra = async (mitraId: string) => {
    const result = await import('sweetalert2').then(Swal => {
      return Swal.default.fire({
        title: 'Hapus Mitra?',
        html: `Apakah Anda yakin ingin menghapus mitra ini?<br><br>
               <span class="text-red-600 font-medium">⚠️ Perhatian:</span><br>
               Data akan dihapus dari:<br>
               • Database Mitra<br>
               • Data Pelunasan<br>
               • Semua data terkait lainnya<br><br>
               <span class="text-red-600">Data yang dihapus tidak dapat dikembalikan!</span>`,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#ef4444',
        cancelButtonColor: '#6b7280',
        confirmButtonText: 'Ya, Hapus Semua',
        cancelButtonText: 'Batal'
      });
    });

    if (!result.isConfirmed) return;

    // Show loading state
    await import('sweetalert2').then(Swal => {
      Swal.default.fire({
        title: 'Menghapus data...',
        html: 'Mohon tunggu, sedang menghapus data mitra dari semua database',
        allowOutsideClick: false,
        allowEscapeKey: false,
        didOpen: () => {
          Swal.default.showLoading();
        }
      });
    });

    const success = await deleteMitraAPI(mitraId);
    if (success) {
      await import('sweetalert2').then(Swal => {
        Swal.default.fire({
          title: 'Terhapus!',
          text: 'Mitra berhasil dihapus dari semua database',
          icon: 'success',
          confirmButtonColor: '#10b981'
        });
      });
      await loadData();
    } else {
      await import('sweetalert2').then(Swal => {
        Swal.default.fire({
          title: 'Gagal!',
          text: 'Gagal menghapus mitra',
          icon: 'error',
          confirmButtonColor: '#ef4444'
        });
      });
    }
  };

  async function showMitraDetailModal(mitra: any) {
    const modal = document.getElementById('mitraDetailModal');
    const content = document.getElementById('mitraDetailContent');
    
    if (modal && content) {
      const validSubBrands = ['Masakan Mas Gawa', 'Warnas', 'Mas Gaw'];
      let subBrandDisplay = '-';
      
      if (mitra.paketUsaha === 'RM Nusantara' && mitra.rmNusantaraSubMenu && validSubBrands.includes(mitra.rmNusantaraSubMenu)) {
        subBrandDisplay = `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800 border border-purple-200">
          ${mitra.rmNusantaraSubMenu}
        </span>`;
      }
      
      // Check pelunasan status jika paket adalah DP
      let pelunasanStatusHTML = '';
      if (mitra.nilaiPaketUsaha === 'DP') {
        try {
          const token = localStorage.getItem('adminToken');
          const API_URL = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
          const pelunasanResponse = await fetch(`${API_URL}/api/admin/mitra_pelunasan`, {
            method: 'GET',
            headers: {
              'Authorization': `Bearer ${token}`,
              'Content-Type': 'application/json',
            },
          });

          if (pelunasanResponse.ok) {
            const pelunasanResult = await pelunasanResponse.json();
            if (pelunasanResult.success && pelunasanResult.data) {
              const pelunasan = pelunasanResult.data.find((p: any) => 
                p.email === mitra.email || p.mitraId === mitra._id
              );

              if (pelunasan && pelunasan.statusPelunasan === 'lunas') {
                pelunasanStatusHTML = `<div><strong>Status Pelunasan:</strong> <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-green-100 text-green-800 border-2 border-green-300">✓ LUNAS</span></div>`;
              } else {
                pelunasanStatusHTML = `<div><strong>Status Pelunasan:</strong> <span class="inline-flex items-center px-3 py-1 rounded-full text-sm font-semibold bg-red-100 text-red-800 border-2 border-red-300 animate-pulse">✗ BELUM LUNAS</span></div>`;
              }
            }
          }
        } catch (error) {
          console.error('Error checking pelunasan status:', error);
        }
      }
      
      content.innerHTML = `
        <div class="grid grid-cols-2 gap-4">
          <div><strong>Nama:</strong> ${mitra.namaMitra || mitra.nama || '-'}</div>
          <div><strong>Email:</strong> ${mitra.email || '-'}</div>
          <div><strong>No HP:</strong> ${mitra.noHp || '-'}</div>
          <div><strong>Paket Brand:</strong> <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">${mitra.paketUsaha || '-'}</span></div>
          <div><strong>Sub Brand:</strong> ${subBrandDisplay}</div>
          <div><strong>Status:</strong> <span class="text-green-600 font-semibold">Disetujui</span></div>
          ${pelunasanStatusHTML}
        </div>
      `;
      modal.classList.remove('hidden');
    }
  }

  (window as any).closeMitraDetailModal = () => {
    const modal = document.getElementById('mitraDetailModal');
    if (modal) {
      modal.classList.add('hidden');
    }
  };
</script>
